rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Substituir pelos dois UIDs de Authentication antes de publicar estas regras.
    function member() { return request.auth != null && request.auth.uid in ['UID_MANUEL', 'UID_PAR']; }
    function text(v, max) { return v is string && v.size() <= max; }
    match /members/{uid} {
      allow read: if member();
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id','name','status','until','ts'])
        && request.resource.data.id == uid
        && text(request.resource.data.name,40) && request.resource.data.name.size()>0
        && request.resource.data.status in ['disponivel','ocupado','dormir','sesta']
        && request.resource.data.until is number && request.resource.data.until >= 0
        && request.resource.data.ts is number;
      allow delete: if member() && request.auth.uid == uid;
    }
    match /moods/{id} {
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly(['id','from','day','period','mood','note','ts'])
        && request.resource.data.id == id && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.day + '_' + request.resource.data.period
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.period in ['manha','tarde','noite']
        && request.resource.data.mood in ['radiante','bem','tranquilo','cansado','triste','stressado']
        && text(request.resource.data.note,500) && request.resource.data.ts is number;
      allow delete: if member() && resource.data.from == request.auth.uid;
    }
    match /events/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['id','from','kind','text','ts','image','lat','lng'])
        && request.resource.data.id == id && request.resource.data.from == request.auth.uid
        && text(request.resource.data.text,2000) && request.resource.data.ts is number
        && request.resource.data.kind in ['text','quick','note','drawing','location']
        && (request.resource.data.kind != 'drawing' || (text(request.resource.data.image,179999) && request.resource.data.image.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')))
        && (request.resource.data.kind != 'location' || (request.resource.data.lat is number && request.resource.data.lng is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 && request.resource.data.lng >= -180 && request.resource.data.lng <= 180));
      allow delete: if member() && resource.data.from == request.auth.uid;
    }
  }
}
